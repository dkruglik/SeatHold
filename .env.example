# Non-secret defaults for every variable the app reads. Copy to .env and adjust.
# Production values come from the platform (Secrets Manager or Parameter Store), never from a file.

# local or production. Production refuses local-only values (see DECISIONS.md O22).
APP_ENV=local

# Backend (backend/src/config)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
# Local placeholder for the Docker Compose Postgres below. A real database URL carries a secret password.
DATABASE_URL=postgresql://seatholder:seatholder@localhost:5432/seatholder
# Max connections this instance opens; instances times this stays under the RDS Proxy and PostgreSQL limits.
DATABASE_POOL_MAX=10
LOG_LEVEL=info
# Keep below the container stop timeout.
SHUTDOWN_TIMEOUT_MS=10000
# The browser origin; in production it must be set explicitly and be https.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (frontend/src/app/config). Public: never put a secret in a VITE_ variable.
VITE_API_BASE_URL=/api

# Docker Compose (docker-compose.yml): local Postgres container only.
POSTGRES_USER=seatholder
POSTGRES_PASSWORD=seatholder
POSTGRES_DB=seatholder
