# Non-secret defaults for every variable the app reads. Copy to .env and adjust.
# Production values come from the platform (Secrets Manager or Parameter Store), never from a file.

# local or production. Production refuses local-only values (see DECISIONS.md O22).
APP_ENV=local

# Backend (backend/src/config)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
# Local placeholder for the Docker Compose Postgres below. A real database URL carries a secret password.
DATABASE_URL=postgresql://seatholder:seatholder@localhost:5432/seatholder
# Max connections this instance opens; instances times this stays under the RDS Proxy and PostgreSQL limits.
DATABASE_POOL_MAX=10
LOG_LEVEL=info
# Keep below the container stop timeout.
SHUTDOWN_TIMEOUT_MS=10000
# The browser origin; in production it must be set explicitly and be https.
FRONTEND_ORIGIN=http://localhost:5173

# Email: smtp (Mailpit locally, Amazon SES SMTP in production) or console (tests only; refused in production).
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@seathold.local
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER and SMTP_PASS are set together in production only. SMTP_PASS is a secret: never put it in this file.

# Login codes. AUTH_CODE_PEPPER is a SECRET: the value below is a placeholder for local development only and
# production refuses it. Production injects its own (at least 32 random characters) from the secret store.
AUTH_CODE_PEPPER=local-only-pepper-replace-in-production-0000
# CSRF_SECRET is a SECRET: it signs the cookie that holds the CSRF secret. The value below is a placeholder for local
# development only and production refuses it. Production injects its own (at least 32 random characters) from the secret store.
CSRF_SECRET=local-only-csrf-secret-replace-in-production-0000
# At most LIMIT code requests per email in WINDOW minutes, and COOLDOWN seconds between two requests.
AUTH_REQUEST_CODE_LIMIT=5
AUTH_REQUEST_CODE_WINDOW_MINUTES=15
AUTH_REQUEST_CODE_COOLDOWN_SECONDS=60

# Browser session. The cookie `sid` lives SESSION_TTL_DAYS from login (fixed, no idle timeout).
SESSION_TTL_DAYS=30
# Adds the Secure attribute to the session cookie. false for http://localhost; REQUIRED to be true when APP_ENV=production.
COOKIE_SECURE=false

# Booking. A hold lasts HOLD_DURATION_MINUTES, covers at most MAX_SEATS_PER_HOLD seats, and prices default to DEFAULT_CURRENCY (ISO 4217, uppercase).
HOLD_DURATION_MINUTES=10
MAX_SEATS_PER_HOLD=10
DEFAULT_CURRENCY=EUR

# Guest access. A guest link works for GUEST_LINK_TTL_HOURS; at most GUEST_RESEND_LIMIT resends per booking in GUEST_RESEND_WINDOW_MINUTES.
GUEST_LINK_TTL_HOURS=168
GUEST_RESEND_LIMIT=3
GUEST_RESEND_WINDOW_MINUTES=60

# Frontend (frontend/src/app/config). Public: never put a secret in a VITE_ variable.
VITE_API_BASE_URL=/api
# How often the event page polls seat status, in milliseconds.
VITE_SEAT_POLL_INTERVAL_MS=3000

# Docker Compose (docker-compose.yml): local Postgres container only.
POSTGRES_USER=seatholder
POSTGRES_PASSWORD=seatholder
POSTGRES_DB=seatholder
