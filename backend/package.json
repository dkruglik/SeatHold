{
  "name": "@seatholder/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:fast": "vitest run --project integration --exclude \"**/*.slow.test.ts\" --reporter=default --reporter=json --outputFile.json=../perf/raw/integration-fast.json",
    "test:integration:slow": "vitest run --project integration .slow.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "nodemailer": "10.6.1",
    "zod": "4.6.7"
  }
}
